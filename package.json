{
  "name": "flowos",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "vercel-build": "npx tsx scripts/validate-env.ts && turbo run build",
    "generate:connector-manifest": "python apps/runtime/scripts/generate_connector_manifest.py",
    "seed": "tsx scripts/seed.ts seed",
    "seed:reset": "tsx scripts/seed.ts reset"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@playwright/test": "^1.60.0",
    "tsx": "^4.22.4",
    "turbo": "^2.10.10",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
